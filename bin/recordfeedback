#!/usr/bin/env bash
# recordfeedback: record spoken feedback with screen annotations, then hand
# Claude Code one document that joins the words to the pictures.
set -euo pipefail

RF_HOME="${RF_HOME:-$HOME/.recordfeedback}"
RF_MODEL="${RF_MODEL:-$RF_HOME/models/ggml-large-v3-turbo-q5_0.bin}"
RF_LANG="${RF_LANG:-auto}"
RF_DEVICE="${RF_DEVICE:-0}"

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# Follow the install symlink so the overlay binary is found next to the real
# script and not next to ~/.local/bin/rfb.
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$link" ;;
  esac
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
REPO_DIR="$(cd "$BIN_DIR/.." && pwd)"
# Overridable so the test suite can point at the build that carries the selftest
# probes. A session never sets it, and the probes are not in the shipped binary
# to be reached anyway.
OVERLAY_BIN="${RF_OVERLAY_BIN:-$BIN_DIR/rf-overlay}"

CURRENT="$RF_HOME/current"

# What counts as a screenshot. One list, because a format added to only some
# of the places that look for shots goes missing between status and collect.
IMAGE_NAMES=( \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
                 -o -iname '*.gif' -o -iname '*.tiff' -o -iname '*.heic' \) )

# ---------------------------------------------------------------- diagnostics

# A failure prints what failed, the command behind it and the way out, because
# this tool runs while the user is talking to their computer and is not
# watching a terminal.
die() {
  local what="$1" cmd="${2:-}" fix="${3:-}"
  echo "recordfeedback: $what" >&2
  [ -n "$cmd" ] && echo "  command: $cmd" >&2
  [ -n "$fix" ] && echo "  fix: $fix" >&2
  exit 1
}

DESKTOP_HINT='Open System Settings, Privacy and Security, Files and Folders, find the terminal application Claude Code runs in, and turn on Desktop Folder. Full Disk Access for the same application works too. macOS asks once and remembers a refusal.'

SCREEN_HINT='Open System Settings, Privacy and Security, Screen and System Audio Recording, turn on the terminal application Claude Code runs in, and quit and reopen it. macOS does not apply the change to a running process.'

MIC_HINT='the terminal application needs Microphone permission in System Settings, Privacy and Security, Microphone. macOS asks once, and if the prompt was refused the switch has to be turned on by hand.'

SILENCE_HINT='check that the right input is selected and that its volume is not at zero, in System Settings, Sound, Input. An avfoundation index is not stable across reboots or plugged in devices, so a virtual mixer that is routed to nothing can take the index the microphone had. Run recordfeedback devices to see the list and start --device N to pick one.'

# A live microphone in a silent room still carries a noise floor, measured on
# this machine between -74 and -81 dBFS over repeated samples. A stream of zeros
# reads -inf here and -91 through ffmpeg's volumedetect, which clamps. So this
# sits between the two with a handful of dB either side, and the level is taken
# as the loudest of several seconds rather than the latest, so a pause between
# two sentences cannot reach it. Anything at or below is lost audio, whether the
# cause is a denied permission, a muted device or an input volume left at zero.
DEAD_DBFS=-85

# ------------------------------------------------------------------- plumbing

# macOS ships no timeout(1), and every external call here can hang on a
# permission prompt that never comes back.
run_with_timeout() {
  local secs="$1"
  shift
  "$@" &
  local pid=$!
  local ticks=0
  local limit=$((secs * 10))
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$ticks" -ge "$limit" ]; then
      kill -TERM "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done
  local status=0
  wait "$pid" || status=$?
  return "$status"
}

expand_tilde() {
  case "$1" in
    "~") echo "$HOME" ;;
    "~/"*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

shot_dir() {
  if [ -n "${RF_SHOT_DIR:-}" ]; then
    expand_tilde "$RF_SHOT_DIR"
    return
  fi
  local configured
  configured="$(defaults read com.apple.screencapture location 2>/dev/null || true)"
  if [ -n "$configured" ]; then
    expand_tilde "$configured"
  else
    echo "$HOME/Desktop"
  fi
}

# The settings file is the overlay's, and the CLI only ever reads it, with one
# exception: --voice has to be able to turn voice control on before the overlay
# it configures has started.
settings_file() { echo "$RF_HOME/settings.json"; }

voice_enabled() {
  local file
  file="$(settings_file)"
  [ -f "$file" ] || return 1
  [ "$(jq -r '.voice.enabled // false' "$file" 2>/dev/null)" = "true" ]
}

# The defaults the overlay falls back to when a key is missing. Named here too
# because the CLI writes this file when --voice is used before an overlay has
# ever run, and a block with only the switch in it is a file that answers none
# of the questions a person opens it to ask.
VOICE_TRIGGER_DEFAULT="let's"
VOICE_ESCAPE_DEFAULT="not a command"

set_voice_enabled() {
  local wanted="$1" file on
  file="$(settings_file)"
  mkdir -p "$RF_HOME"
  on="$([ "$wanted" = 1 ] && echo true || echo false)"
  local existing='{}'
  [ -f "$file" ] && existing="$(cat "$file")"
  # The whole block is written, the switch alongside the words, so the file says
  # what can be said and not only whether anything is listening. Whatever is
  # already there wins, because it is what the user set.
  #
  # A settings file that cannot be parsed leaves every default in place rather
  # than costing the user their stop key, so a broken one is replaced and never
  # merged into.
  echo "$existing" | jq \
    --argjson on "$on" \
    --arg trigger "$VOICE_TRIGGER_DEFAULT" \
    --arg escape "$VOICE_ESCAPE_DEFAULT" \
    '.voice = ((.voice // {})
               | .enabled = $on
               | .trigger = (.trigger // $trigger)
               | .escape = (.escape // $escape))' > "$file.new" 2>/dev/null \
    || printf '{"voice":{"enabled":%s,"trigger":%s,"escape":%s}}\n' \
         "$on" "$(printf '%s' "$VOICE_TRIGGER_DEFAULT" | jq -R .)" \
         "$(printf '%s' "$VOICE_ESCAPE_DEFAULT" | jq -R .)" > "$file.new"
  mv "$file.new" "$file"
}

# The audio source. Tests replace the whole avfoundation input so the pipeline
# runs without a microphone and without a person.
ffmpeg_input() {
  if [ -n "${RF_FFMPEG_INPUT:-}" ]; then
    printf '%s' "$RF_FFMPEG_INPUT"
  else
    printf '%s' "-f avfoundation -i :$RF_DEVICE"
  fi
}

# A second output of the same recorder, so the level is measured on the stream
# that will be transcribed and not on a second capture opened to ask. It has to
# be a separate output because audio.wav is unreadable while the session runs:
# the wav muxer holds every sample until ffmpeg exits and the file is still zero
# bytes minutes in, with or without -flush_packets.
#
# The segment muxer is what makes it readable. It closes each file when the
# segment ends, and a closed file is a flushed one, so a completed second is on
# disk a second after it was spoken. Nothing else ffmpeg can write flushes while
# it runs. segment_wrap bounds the cost: six files of one second each, about
# 190 kB, whatever the length of the session.
LEVEL_DIR=levels
LEVEL_WRAP=6

# The loudest recent second, in dBFS, or nothing when the recorder has not
# finished a segment yet. The loudest and not the latest, because a person draws
# breath mid sentence and a window that lands in the pause is silent for a
# reason that has nothing wrong with it.
level_dbfs() {
  local session="$1"
  [ -d "$session/$LEVEL_DIR" ] || return 1
  python3 - "$session/$LEVEL_DIR" <<'PY'
import array, math, os, sys, time

directory = sys.argv[1]
now = time.time()
best = 0.0
seen = False
for name in os.listdir(directory):
    if not name.endswith(".pcm"):
        continue
    path = os.path.join(directory, name)
    try:
        stat = os.stat(path)
    except OSError:
        continue
    # Under segment_wrap the oldest files are overwritten in place, so age and
    # not the name is what says whether a segment is still evidence. A recorder
    # that died leaves loud segments behind and they must not read as alive.
    if now - stat.st_mtime > 8:
        continue
    # An eighth of a second is the shortest window worth judging. Below that the
    # segment is the one being written right now and holds a sliver.
    if stat.st_size < 4000:
        continue
    try:
        with open(path, "rb") as handle:
            samples = array.array("h")
            samples.frombytes(handle.read(stat.st_size // 2 * 2))
    except OSError:
        continue
    if not samples:
        continue
    seen = True
    total = 0
    for one in samples:
        total += one * one
    best = max(best, math.sqrt(total / len(samples)))

if not seen:
    raise SystemExit(1)
# Digital silence has no logarithm, and -inf is the honest answer rather than a
# floor picked to keep the arithmetic tidy.
print("-inf" if best == 0 else "%.1f" % (20 * math.log10(best / 32768.0)))
PY
}

# True when the recorder is writing silence rather than quiet. Unknown counts as
# alive, because a level that cannot be measured is a reason to say nothing and
# never a reason to throw away somebody's session.
input_is_dead() {
  local session="$1" dbfs
  dbfs="$(level_dbfs "$session")" || return 1
  [ "$dbfs" = "-inf" ] && return 0
  [ "$(python3 -c "print(1 if float('$dbfs') <= $DEAD_DBFS else 0)" 2>/dev/null || echo 0)" = 1 ]
}

# Waits for the recorder to finish enough segments to be worth judging, up to a
# deadline in tenths of a second, and answers with the level it settled on.
await_level() {
  local session="$1" tenths="${2:-40}" waited=0 dbfs=""
  while [ "$waited" -lt "$tenths" ]; do
    local ready
    ready="$(find "$session/$LEVEL_DIR" -name '*.pcm' -size +4000c 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$ready" -ge 2 ] && dbfs="$(level_dbfs "$session")"; then
      printf '%s' "$dbfs"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  dbfs="$(level_dbfs "$session")" || return 1
  printf '%s' "$dbfs"
}

pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

read_pid() {
  local file="$1"
  [ -f "$file" ] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  printf '%s' "$pid"
}

# The live session, or nothing. A current symlink whose recorder is dead is
# stale and never blocks a new session.
live_session() {
  [ -L "$CURRENT" ] || return 1
  local dir
  dir="$(readlink "$CURRENT")"
  [ -d "$dir" ] || return 1
  local pid
  pid="$(read_pid "$dir/ffmpeg.pid")" || return 1
  pid_alive "$pid" || return 1
  printf '%s' "$dir"
}

# Seconds between two reference files, or between one and now.
elapsed_seconds() {
  local ref="$1" until="${2:-}"
  local start end
  start="$(stat -f %m "$ref")"
  if [ -n "$until" ] && [ -f "$until" ]; then
    end="$(stat -f %m "$until")"
  else
    end="$(date +%s)"
  fi
  echo $((end - start))
}

format_mmss() {
  local total="$1"
  printf '%02d:%02d' $((total / 60)) $((total % 60))
}

# ---------------------------------------------------------------------- doctor

DOCTOR_FAILED=0

check() {
  local status="$1" name="$2" detail="$3"
  printf '%-4s %-18s %s\n' "$status" "$name" "$detail"
  [ "$status" = "fail" ] && DOCTOR_FAILED=1
  return 0
}

check_binary() {
  local name="$1" hint="$2"
  local path
  path="$(command -v "$name" 2>/dev/null || true)"
  if [ -n "$path" ]; then
    check ok "$name" "$path"
  else
    check fail "$name" "not found. $hint"
  fi
}

cmd_doctor() {
  check_binary ffmpeg "install it with: brew install ffmpeg"
  check_binary ffprobe "install it with: brew install ffmpeg"
  check_binary fswatch "install it with: brew install fswatch"
  check_binary whisper-cli "install it with: brew install whisper-cpp"
  check_binary swiftc "install the Xcode command line tools with: xcode-select --install"
  check_binary jq "install it with: brew install jq"
  check_binary python3 "install it with: brew install python"
  check_binary screencapture "part of macOS, expected at /usr/sbin/screencapture"

  # An overlay whose CLI died keeps every click on the screen and answers to
  # nothing, and from in front of it there is no way to tell that from a
  # session that is simply running. This is where a person looks when they
  # cannot make the window go away.
  local live stray=""
  live="$(live_session || true)"
  local pid
  while read -r pid; do
    [ -n "$pid" ] || continue
    local owner=""
    [ -n "$live" ] && owner="$(read_pid "$live/overlay.pid" 2>/dev/null || true)"
    [ "$pid" = "$owner" ] && continue
    stray="$stray $pid"
  done <<< "$(pgrep -f '(^|/)rf-overlay$' 2>/dev/null || true)"
  if [ -n "$stray" ]; then
    check fail "stray overlay" "an overlay is on the screen with no session behind it, at pid$stray. It answers to nothing and holds its own window. End it with: kill$stray"
  else
    check ok "stray overlay" "none, so nothing is holding the screen"
  fi

  if [ -f "$RF_MODEL" ]; then
    local size
    size="$(du -h "$RF_MODEL" | cut -f1 | tr -d ' ')"
    check ok "whisper model" "$RF_MODEL ($size)"
  else
    check fail "whisper model" "$RF_MODEL is missing. Download a ggml model into $RF_HOME/models, or point RF_MODEL at one."
  fi

  local shots
  shots="$(shot_dir)"
  if [ ! -d "$shots" ]; then
    check fail "screenshot folder" "$shots does not exist. Set RF_SHOT_DIR, or change the folder in the screenshot app."
  elif ls "$shots" >/dev/null 2>&1; then
    check ok "screenshot folder" "$shots"
  else
    check fail "screenshot folder" "$shots exists but macOS will not let this terminal read it, so no screenshot can ever be collected. $DESKTOP_HINT"
  fi

  local out="$RF_HOME/doctor-mic.wav"
  mkdir -p "$RF_HOME"
  rm -f "$out"
  local input status=0
  input="$(ffmpeg_input)"
  # Real capture is the only honest test of the permission. A second of it and
  # not half a one, because the level and not the byte count is what is judged
  # now, and a short window lands on a quiet moment between two breaths often
  # enough to read several dB below the room it was taken in.
  # shellcheck disable=SC2086
  run_with_timeout 20 ffmpeg -nostdin -hide_banner -loglevel error -y \
    $input -t 1 -ac 1 -ar 16000 -c:a pcm_s16le "$out" >/dev/null 2>&1 || status=$?
  local bytes=0
  [ -f "$out" ] && bytes="$(stat -f %z "$out")"
  # Bytes are not sound. A denied microphone, a muted device and a virtual mixer
  # routed to nothing all hand over a full sized file of zeros, and reporting
  # that as a working microphone is the check that let a whole session be
  # recorded into nothing.
  local dbfs=""
  [ "$bytes" -gt 44 ] && dbfs="$(audio_dbfs "$out" 2>/dev/null || true)"
  local dead=0
  if [ -n "$dbfs" ]; then
    case "$dbfs" in
      *inf*) dead=1 ;;
      *) dead="$(python3 -c "print(1 if float('$dbfs') <= $DEAD_DBFS else 0)" 2>/dev/null || echo 0)" ;;
    esac
  fi
  if [ "$status" -eq 0 ] && [ "$bytes" -gt 44 ] && [ "$dead" = 1 ]; then
    check fail "microphone" "it opened and every sample it captured was zero, at $dbfs dBFS. A live microphone in a quiet room reads about -75. A session recorded through this would look like it was working and transcribe to nothing. $SILENCE_HINT"
  elif [ "$status" -eq 0 ] && [ "$bytes" -gt 44 ]; then
    check ok "microphone" "hearing ${dbfs:-?} dBFS from ${RF_FFMPEG_INPUT:-avfoundation input $RF_DEVICE}"
  elif [ "$status" -eq 124 ]; then
    check fail "microphone" "ffmpeg did not return within 20 seconds. A permission prompt may be waiting on screen. $MIC_HINT"
  else
    check fail "microphone" "captured no audio. $MIC_HINT"
  fi
  rm -f "$out"

  if [ -x "$OVERLAY_BIN" ]; then
    check ok "overlay" "$OVERLAY_BIN"
    # Denied, screencapture still writes a file and the file is only the
    # wallpaper, so this failure is invisible until the shots are read.
    if "$OVERLAY_BIN" --check-capture > /dev/null 2>&1; then
      check ok "screen recording" "screenshots will contain your windows"
    else
      check fail "screen recording" "macOS is not letting this terminal record the screen, so every screenshot would be the wallpaper and nothing else. $SCREEN_HINT"
    fi

    # Only reported when it was asked for. Voice control is off by default, and
    # a permission nobody needs is not a thing to report as missing.
    local speech
    speech="$("$OVERLAY_BIN" --check-speech 2>/dev/null || true)"
    local speech_on speech_permission speech_ondevice
    speech_on="$(printf '%s\n' "$speech" | sed -n 's/^enabled //p')"
    speech_permission="$(printf '%s\n' "$speech" | sed -n 's/^permission //p')"
    speech_ondevice="$(printf '%s\n' "$speech" | sed -n 's/^on-device //p')"
    if [ "${speech_on:-0}" = 1 ]; then
      if [ "$speech_permission" = granted ] && [ "${speech_ondevice:-0}" = 1 ]; then
        check ok "voice control" "on, recognised on this Mac"
      elif [ "$speech_permission" = refused ]; then
        check fail "voice control" "on, but Speech Recognition was refused, so nothing is listening. Turn it on in System Settings, Privacy and Security, Speech Recognition."
      elif [ "${speech_ondevice:-0}" != 1 ]; then
        check fail "voice control" "on, but this machine has no offline recogniser for en-US, and recordfeedback will not send a recording of your session to a server. Download the offline dictation voice in System Settings, Keyboard, Dictation."
      else
        check warn "voice control" "on, and Speech Recognition is $speech_permission. macOS asks at the start of the first session that listens, and nothing listens until it is answered."
      fi
    fi
  else
    check warn "overlay" "not built. Run $REPO_DIR/overlay/build.sh. Recording works without it, annotations do not."
  fi

  local uv_path
  uv_path="$(command -v uv 2>/dev/null || true)"
  if [ -n "$uv_path" ]; then
    check ok "uv" "$uv_path"
  else
    check warn "uv" "not found. Only the overlay pixel test needs it."
  fi

  if [ "$DOCTOR_FAILED" -eq 1 ]; then
    echo
    echo "Some checks failed. The lines above say what to do about each one."
    return 1
  fi
  echo
  echo "Everything the tool needs is present."
}

# Microseconds of audio ffmpeg says it has recorded so far, or 0.
recorded_us() {
  local file="$1/ffmpeg.progress"
  [ -f "$file" ] || { echo 0; return 0; }
  local v
  v="$(grep -a '^out_time_us=' "$file" 2>/dev/null | tail -n 1 | cut -d= -f2)"
  case "$v" in
    ''|*[!0-9]*) echo 0 ;;
    *) echo "$v" ;;
  esac
}

# ---------------------------------------------------------------- the session

new_session_dir() {
  local stamp base dir
  stamp="$(date +%Y%m%d-%H%M%S)"
  base="$RF_HOME/sessions"
  dir="$base/$stamp"
  # Two sessions in the same second is unlikely and still has to work.
  local n=2
  while [ -e "$dir" ]; do
    dir="$base/$stamp-$n"
    n=$((n + 1))
  done
  mkdir -p "$dir/shots"
  printf '%s' "$dir"
}

write_meta() {
  local session="$1" note="$2" device="$3" status="$4"
  local branch
  branch="$(git -C "$PWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  jq -n \
    --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg started_local "$(date +%Y-%m-%dT%H:%M:%S%z)" \
    --arg cwd "$PWD" \
    --arg branch "$branch" \
    --arg note "$note" \
    --arg device "$device" \
    --arg lang "$RF_LANG" \
    --arg status "$status" \
    '{started: $started, started_local: $started_local, cwd: $cwd, branch: $branch,
      note: $note, device: $device, lang: $lang, status: $status}' \
    > "$session/meta.json"
}

set_meta() {
  local session="$1" key="$2" value="$3"
  local tmp="$session/meta.json.tmp"
  jq --arg v "$value" ".$key = \$v" "$session/meta.json" > "$tmp" && mv "$tmp" "$session/meta.json"
}

# Blocks until the pid is gone or the deadline passes. Tenths of a second.
wait_for_exit() {
  local pid="$1" tenths="$2" waited=0
  while [ "$waited" -lt "$tenths" ]; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
    waited=$((waited + 1))
  done
  return 1
}

# ffmpeg here ignores SIGINT and SIGTERM, and a SIGKILL leaves a zero byte
# file because the audio is still in its output buffer. Its own q command is
# the only shutdown that produces a playable recording.
stop_recorder() {
  local session="$1"
  local pid
  pid="$(read_pid "$session/ffmpeg.pid")" || return 0
  pid_alive "$pid" || return 0

  local ctl="$session/ffmpeg.ctl"
  if [ -p "$ctl" ]; then
    # Opening a FIFO for writing blocks when nothing holds the read end, so
    # never let that block the whole stop.
    run_with_timeout 5 bash -c 'printf q > "$1"' _ "$ctl" >/dev/null 2>&1 || true
    wait_for_exit "$pid" 100 && return 0
  fi

  echo "recordfeedback: the recorder did not answer q, forcing it down." >&2
  echo "  the audio may be lost, ffmpeg keeps it buffered until it exits cleanly." >&2
  kill -TERM "$pid" 2>/dev/null || true
  wait_for_exit "$pid" 30 && return 0
  kill -KILL "$pid" 2>/dev/null || true
  wait_for_exit "$pid" 20 || true
  return 0
}

# The shortcuts are settings, so the overlay is the only thing that knows what
# they currently are. A second copy of the list in here is a copy that goes
# stale the first time anybody rebinds one.
print_hotkeys() {
  local keys
  keys="$("$OVERLAY_BIN" --print-keys 2>/dev/null)" || keys=""
  if [ -z "$keys" ]; then
    echo "  the overlay would not report its keys, so use its buttons instead."
    return 0
  fi
  local draw shot region stop undo clear hide listen
  draw="$(printf '%s\n' "$keys" | sed -n 's/^draw //p')"
  shot="$(printf '%s\n' "$keys" | sed -n 's/^screenshot //p')"
  region="$(printf '%s\n' "$keys" | sed -n 's/^region //p')"
  stop="$(printf '%s\n' "$keys" | sed -n 's/^stop //p')"
  undo="$(printf '%s\n' "$keys" | sed -n 's/^undo //p')"
  clear="$(printf '%s\n' "$keys" | sed -n 's/^clear //p')"
  hide="$(printf '%s\n' "$keys" | sed -n 's/^hide //p')"
  listen="$(printf '%s\n' "$keys" | sed -n 's/^listen //p')"
  echo "  $draw draw, $shot screenshot, $region region, $stop stop"
  echo "  $undo undo, $clear clear, $hide hide the marks"
  # Printed whether or not it is on, because the key is what turns it on and a
  # key nobody is told about is a feature nobody finds.
  if voice_enabled; then
    echo "  $listen stop listening for spoken commands"
  else
    echo "  $listen start listening for spoken commands"
  fi
}

# The overlay cannot talk to the user: it writes to a log nobody opens. What it
# has to say is said at the moment it matters, which is here, because most of
# it is something the user has to go and click.
report_overlay_warnings() {
  local session="$1" waited=0
  while [ "$waited" -lt 25 ]; do
    [ -f "$session/overlay.ready" ] && break
    sleep 0.1
    waited=$((waited + 1))
  done
  # The checks the overlay runs after its windows are up take a moment longer
  # than the ready file does.
  sleep 0.7
  [ -s "$session/overlay.log" ] || return 0
  grep '^rf-overlay:' "$session/overlay.log" 2>/dev/null | sed 's/^rf-overlay: /  /' >&2 || true
}

stop_overlay() {
  local session="$1"
  local pid
  pid="$(read_pid "$session/overlay.pid")" || return 0
  pid_alive "$pid" || return 0
  kill -TERM "$pid" 2>/dev/null || true
  wait_for_exit "$pid" 30 || kill -KILL "$pid" 2>/dev/null || true
  return 0
}

# ----------------------------------------------------------------------- start

cmd_start() {
  local note="" no_overlay=0 voice=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --note) note="${2:-}"; shift 2 ;;
      --device) RF_DEVICE="${2:-}"; shift 2 ;;
      --no-overlay) no_overlay=1; shift ;;
      --voice) voice=1; shift ;;
      --no-voice) voice=0; shift ;;
      *) die "start: unknown option '$1'" "recordfeedback start [--note TEXT] [--device N] [--no-overlay] [--voice|--no-voice]" ;;
    esac
  done

  # The flag writes the setting rather than living only for this session, so
  # that the settings window and the flag cannot disagree about whether the
  # session that is running is listening.
  [ -n "$voice" ] && set_voice_enabled "$voice"

  local live
  if live="$(live_session)"; then
    local ran
    ran="$(format_mmss "$(elapsed_seconds "$live/start.ref")")"
    die "a session is already running, started $ran ago
  session: $live
  stop it with: recordfeedback stop
  throw it away with: recordfeedback abort"
  fi
  # A current symlink whose recorder is dead is stale and means nothing.
  rm -f "$CURRENT"

  mkdir -p "$RF_HOME/sessions"
  local session
  session="$(new_session_dir)"
  touch "$session/start.ref"
  write_meta "$session" "$note" "${RF_FFMPEG_INPUT:+synthetic}${RF_FFMPEG_INPUT:-$RF_DEVICE}" "recording"

  local ctl="$session/ffmpeg.ctl"
  mkfifo "$ctl"
  local input
  input="$(ffmpeg_input)"
  mkdir -p "$session/$LEVEL_DIR"
  # 0<> keeps a writer on the FIFO inside ffmpeg itself, so the FIFO never
  # reaches end of file when this shell exits and q still arrives at stop.
  # shellcheck disable=SC2086
  nohup ffmpeg -hide_banner -loglevel warning \
    -progress "$session/ffmpeg.progress" \
    $input \
    -ac 1 -ar 16000 -c:a pcm_s16le "$session/audio.wav" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    -f segment -segment_time 1 -segment_wrap "$LEVEL_WRAP" -segment_format s16le \
    "$session/$LEVEL_DIR/%d.pcm" \
    0<>"$ctl" >"$session/ffmpeg.log" 2>&1 &
  local pid=$!
  echo "$pid" > "$session/ffmpeg.pid"
  ln -sfn "$session" "$CURRENT"

  # ffmpeg buffers the output file, so audio.wav is still empty seconds in.
  # The progress stream is the first honest sign that audio is arriving.
  local recorded=0 waited=0
  while [ "$waited" -lt 50 ]; do
    pid_alive "$pid" || break
    recorded="$(recorded_us "$session")"
    [ "$recorded" -gt 0 ] && break
    sleep 0.1
    waited=$((waited + 1))
  done
  if ! pid_alive "$pid" || [ "$recorded" -le 0 ]; then
    # disown before the kill, or bash reports the dead job on the terminal and
    # its notice lands under the fix the user is meant to read.
    disown "$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
    echo "recordfeedback: the recorder produced no audio." >&2
    echo "  command: ffmpeg $input -ac 1 -ar 16000 -c:a pcm_s16le $session/audio.wav" >&2
    echo "  last lines of $session/ffmpeg.log:" >&2
    tail -n 20 "$session/ffmpeg.log" 2>/dev/null | sed 's/^/    /' >&2
    echo "  fix: $MIC_HINT" >&2
    rm -f "$CURRENT"
    rm -rf "$session"
    exit 1
  fi

  # A recorder that runs and captures silence is the failure that costs a whole
  # session, because everything the user can see says it is working. It is
  # refused here, where refusing costs nothing but the two seconds spent
  # proving it, and never mid session, where refusing would throw away what the
  # user has already said.
  local dbfs
  if dbfs="$(await_level "$session" 30)" && input_is_dead "$session" 6; then
    disown "$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
    echo "recordfeedback: the recorder is running but the input is silence." >&2
    echo "  every sample it captured was zero, measured at $dbfs dBFS. A live" >&2
    echo "  microphone in a quiet room reads about -75. Recording this would" >&2
    echo "  have looked exactly like a working session and transcribed to" >&2
    echo "  nothing." >&2
    echo "  command: ffmpeg $input -ac 1 -ar 16000 -c:a pcm_s16le $session/audio.wav" >&2
    echo "  fix: $SILENCE_HINT" >&2
    echo "  fix: if the input is right, $MIC_HINT" >&2
    rm -f "$CURRENT"
    rm -rf "$session"
    exit 1
  fi

  if [ "$no_overlay" -eq 0 ] && [ -x "$OVERLAY_BIN" ]; then
    # RF_CLI is how the overlay finishes a session nobody is listening to. It
    # is this script, so the rescue flushes the recorder the same way a normal
    # stop does rather than reimplementing any of it in Swift.
    # The threshold travels with the launch so the number that refuses a session
    # here and the number the palette raises its alarm on cannot drift apart.
    RF_SESSION="$session" RF_CLI="$SELF" RF_DEAD_DBFS="$DEAD_DBFS" \
      RF_LANG="$RF_LANG" \
      nohup "$OVERLAY_BIN" >"$session/overlay.log" 2>&1 &
    echo "$!" > "$session/overlay.pid"
  fi

  echo "Recording. Talk, and draw on the screen with the hotkeys below."
  if [ "$no_overlay" -eq 0 ] && [ -x "$OVERLAY_BIN" ]; then
    report_overlay_warnings "$session"
    print_hotkeys
    echo "  in draw mode: p pen, a arrow, r rectangle, h highlighter, t text"
    echo "  esc, Done, or the same tool again stops drawing. 1 to 6 colours, [ ] width"
    echo "  change any of these with the gear in the palette, or its menu bar item."
    if voice_enabled; then
      # The prompt is a macOS dialog that stops the recogniser dead until it is
      # answered, and the user is about to start talking at a tool that is not
      # listening yet. So it is said here, at the moment it happens, and not
      # left in a README.
      local trigger
      trigger="$(jq -r '.voice.trigger // "let'"'"'s"' "$(settings_file)" 2>/dev/null)"
      echo "  voice control is on. Say \"$trigger draw\", \"$trigger pick red\","
      echo "  \"$trigger take a screenshot of this area\", \"$trigger clear\"."
      echo "  say \"not a command\" first to say one of those and mean the words."
      echo "  the first session asks for Speech Recognition. Answer the prompt or"
      echo "  nothing is listening. The palette says so if it did not start."
    fi
  else
    echo "  no overlay, so no annotations. shift-cmd-4 still takes screenshots."
    # The overlay is what listens, so this pair is a session that would have sat
    # there not listening with nothing on the screen saying why.
    if voice_enabled; then
      echo "  voice control needs the overlay and there is none, so nothing is"
      echo "  listening for spoken commands this session."
    fi
  fi
  echo "  session: $session"
}

# ---------------------------------------------------------------------- status

cmd_status() {
  local session
  if ! session="$(live_session)"; then
    if [ -L "$CURRENT" ]; then
      echo "No session is running. A stale current symlink points at $(readlink "$CURRENT")."
    else
      echo "No session is running."
    fi
    return 0
  fi
  local secs shots recorded
  secs="$(elapsed_seconds "$session/start.ref")"
  shots="$(count_new_shots "$session")"
  recorded="$(recorded_us "$session")"
  echo "Recording for $(format_mmss "$secs")."
  echo "  session: $session"
  echo "  audio:   $(format_mmss $((recorded / 1000000))) captured"
  local dbfs
  if dbfs="$(level_dbfs "$session" 6)"; then
    if input_is_dead "$session" 6; then
      echo "  input:   SILENT at $dbfs dBFS, nothing is being recorded"
      echo "           $SILENCE_HINT"
    else
      echo "  input:   $dbfs dBFS"
    fi
  else
    echo "  input:   not reported yet"
  fi
  echo "  shots:   $shots so far"
  local note
  note="$(jq -r '.note // ""' "$session/meta.json")"
  [ -n "$note" ] && echo "  note:    $note"
  return 0
}

# Screenshots taken since the session started. Used by status, which has no
# stop.ref yet, so it counts everything newer than start.ref.
count_new_shots() {
  local session="$1"
  local dir inbox=0 folder=0
  dir="$(shot_dir)"
  # The overlay captures into the session inbox, so a count that reads only the
  # screenshot folder tells a person who just pressed the capture key that
  # nothing happened.
  if [ -d "$session/inbox" ]; then
    inbox="$({ find "$session/inbox" -maxdepth 1 -type f "${IMAGE_NAMES[@]}" \
        ! -name '.*' 2>/dev/null || true; } | wc -l | tr -d ' ')"
  fi
  if [ -d "$dir" ]; then
    folder="$({ find "$dir" -maxdepth 1 -type f -newer "$session/start.ref" \
        "${IMAGE_NAMES[@]}" ! -name '.*' 2>/dev/null || true; } | wc -l | tr -d ' ')"
  fi
  echo $((inbox + folder))
}

# ----------------------------------------------------------------------- abort

cmd_abort() {
  local session
  if ! session="$(live_session)"; then
    if [ -L "$CURRENT" ]; then
      session="$(readlink "$CURRENT")"
    else
      echo "No session is running."
      return 0
    fi
  fi
  touch "$session/stop.ref"
  stop_recorder "$session"
  stop_overlay "$session"
  rm -f "$session/ffmpeg.ctl"
  set_meta "$session" status aborted
  rm -f "$CURRENT"
  echo "Aborted. Nothing was transcribed."
  echo "  session: $session"
}

# ---------------------------------------------------------------------- devices

cmd_devices() {
  echo "avfoundation audio inputs. Pass the index to start --device, or set RF_DEVICE."
  ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 \
    | sed -n '/AVFoundation audio devices/,$p' \
    | grep -E '^\[' \
    | sed 's/^\[AVFoundation indev @ [^]]*\] //' \
    | grep -E '^\[[0-9]+\]' || echo "  none found"
}

# ------------------------------------------------------------------------ last

cmd_last() {
  local newest=""
  for dir in "$RF_HOME"/sessions/*/; do
    [ -f "$dir/feedback.md" ] || continue
    newest="$dir"
  done
  [ -n "$newest" ] || die "no session has a feedback.md yet" "" "record one with: recordfeedback start"
  echo "${newest%/}/feedback.md"
}

# --------------------------------------------------------------- screenshots

# Screenshots taken during a session belong to the session, not to the pile on
# the desktop, so they are moved out of the screenshot folder and into the
# archive. RF_KEEP_SHOTS=1 leaves the originals where they were.
cmd_collect() {
  local session="${1:-}"
  if [ -z "$session" ]; then
    session="$(live_session || true)"
    [ -n "$session" ] || die "collect: no session given and none is running" \
      "recordfeedback collect <session directory>"
  fi
  [ -d "$session" ] || die "collect: no such session directory" "" "check the path: $session"
  [ -f "$session/start.ref" ] || die "collect: $session has no start.ref" "" \
    "the session never started, there is nothing to collect"
  [ -f "$session/stop.ref" ] || touch "$session/stop.ref"
  mkdir -p "$session/shots" "$session/inbox"

  local dir
  dir="$(shot_dir)"

  # The overlay captures straight into the session inbox and never touches the
  # screenshot folder. Those shots are always ours, whatever their timestamp.
  local listing="$session/.shot-list"
  : > "$listing"
  { find "$session/inbox" -maxdepth 1 -type f "${IMAGE_NAMES[@]}" \
      ! -name '.*' 2>/dev/null || true; } | while IFS= read -r f; do
    [ -n "$f" ] && printf '%s\toverlay\t%s\n' "$(stat -f %Fm "$f")" "$f" >> "$listing"
  done

  # find prints an error and exits non-zero when macOS denies the folder, and
  # a session with no screenshots at all is a normal session.
  if [ -d "$dir" ]; then
    { find "$dir" -maxdepth 1 -type f \
        -newer "$session/start.ref" ! -newer "$session/stop.ref" \
        "${IMAGE_NAMES[@]}" ! -name '.*' 2>/dev/null || true; } | while IFS= read -r f; do
      [ -n "$f" ] && printf '%s\tfolder\t%s\n' "$(stat -f %Fm "$f")" "$f" >> "$listing"
    done
  fi

  local start_epoch
  start_epoch="$(stat -f %Fm "$session/start.ref")"

  # sort -n on the modification time is the order the shots were taken, which
  # is the order they are numbered in and the order the document reads in.
  local index=0
  : > "$session/.shot-records"
  while IFS=$'\t' read -r mtime source file; do
    [ -n "${file:-}" ] || continue
    index=$((index + 1))
    local ext base offset_ms elapsed name target
    ext="$(printf '%s' "${file##*.}" | tr '[:upper:]' '[:lower:]')"
    offset_ms="$(python3 -c "print(max(0, int(round(($mtime - $start_epoch) * 1000))))")"
    elapsed="$(format_mmss $((offset_ms / 1000)))"
    name="$(printf '%02d-%02d%02d.%s' "$index" $((offset_ms / 60000)) $(((offset_ms / 1000) % 60)) "$ext")"
    target="$session/shots/$name"
    if [ "$source" = overlay ] || [ -n "${RF_KEEP_SHOTS:-}" ]; then
      cp -p "$file" "$target"
      [ "$source" = overlay ] && rm -f "$file"
    else
      mv "$file" "$target"
    fi
    jq -n --argjson index "$index" --arg file "$name" --arg path "$target" \
      --argjson offset_ms "$offset_ms" --arg elapsed "$elapsed" --arg source "$source" \
      --arg taken_at "$(date -r "${mtime%.*}" -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{index: $index, file: $file, path: $path, offset_ms: $offset_ms,
        elapsed: $elapsed, taken_at: $taken_at, source: $source}' >> "$session/.shot-records"
  done < <(sort -n "$listing")

  jq -s '.' "$session/.shot-records" > "$session/shots.json"
  rm -f "$listing" "$session/.shot-records"
  rmdir "$session/inbox" 2>/dev/null || true
  echo "$index"
}

# ------------------------------------------------------------------ transcribe

# whisper-cli writes ggml and Metal loader lines to stderr before any result,
# and the first run of a process loads the embedded Metal library, which took
# 14 seconds when this was measured. Treat stderr as noise, keep it in a log,
# and read only the JSON file.
cmd_transcribe() {
  local session="${1:-}"
  if [ -z "$session" ]; then
    session="$(live_session || true)"
    [ -n "$session" ] || die "transcribe: no session given and none is running" \
      "recordfeedback transcribe <session directory>"
  fi
  [ -d "$session" ] || die "transcribe: no such session directory" "" "check the path: $session"
  [ -f "$session/audio.wav" ] || die "transcribe: $session has no audio.wav" "" \
    "the recorder never wrote one, look at $session/ffmpeg.log"
  [ -f "$RF_MODEL" ] || die "transcribe: the whisper model is missing" "" \
    "expected $RF_MODEL. Download a ggml model there, or set RF_MODEL."

  local status=0
  whisper-cli -m "$RF_MODEL" -f "$session/audio.wav" -l "$RF_LANG" \
    -oj -otxt -of "$session/transcript" -np -t 8 \
    >"$session/whisper.log" 2>&1 || status=$?

  if [ ! -f "$session/transcript.json" ]; then
    echo "recordfeedback: whisper-cli wrote no transcript.json" >&2
    echo "  command: whisper-cli -m $RF_MODEL -f $session/audio.wav -l $RF_LANG -oj -otxt -of $session/transcript -np -t 8" >&2
    echo "  last lines of $session/whisper.log:" >&2
    tail -n 20 "$session/whisper.log" 2>/dev/null | sed 's/^/    /' >&2
    echo "  fix: check the model file and that audio.wav is 16 kHz mono PCM." >&2
    return 1
  fi
  # A silent recording is a valid result, not a failure, so only a missing
  # file counts as one.
  [ -f "$session/transcript.txt" ] || : > "$session/transcript.txt"
  return 0
}

# Words spoken, or nothing. Used to tell a silent session from a real one.
transcript_words() {
  local session="$1"
  [ -f "$session/transcript.json" ] || { echo 0; return 0; }
  jq -r '[.transcription[]?.text] | join(" ")' "$session/transcript.json" 2>/dev/null \
    | tr -s '[:space:]' '\n' | grep -c '[[:alnum:]]' || echo 0
}

# ------------------------------------------------------------------------ wait

# One slash command has to cover a session of any length, and a Claude Code
# tool call cannot run longer than 600 seconds. So wait comes back with a
# timeout that means nothing is wrong and the caller simply calls it again.
cmd_wait() {
  local timeout=570
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2 ;;
      *) die "wait: unknown option '$1'" "recordfeedback wait [--timeout SECONDS]" ;;
    esac
  done
  case "$timeout" in
    ''|*[!0-9]*) die "wait: --timeout takes whole seconds, got '$timeout'" ;;
  esac

  local session
  session="$(live_session || true)"
  [ -n "$session" ] || die "wait: no session is running" "" \
    "start one with: recordfeedback start"

  local pid
  pid="$(read_pid "$session/ffmpeg.pid")" || pid=""

  # Half a second is fast enough that the stop hotkey feels immediate and slow
  # enough to cost nothing over an hour.
  local ticks=0
  local limit=$((timeout * 2))
  while [ "$ticks" -lt "$limit" ]; do
    [ -f "$session/stop" ] && return 0
    if [ -n "$pid" ] && ! pid_alive "$pid"; then
      echo "recordfeedback: the recorder stopped on its own." >&2
      echo "  last lines of $session/ffmpeg.log:" >&2
      tail -n 20 "$session/ffmpeg.log" 2>/dev/null | sed 's/^/    /' >&2
      echo "  fix: run recordfeedback stop to keep whatever was recorded." >&2
      return 3
    fi
    sleep 0.5
    ticks=$((ticks + 1))
  done
  return 2
}

# ------------------------------------------------------------------- feedback

# The join is the reason this tool exists: a picture placed at the second it
# was taken inside a transcript. The merge is real text work, so it is python
# and not a pile of jq, and python3 is already a dependency doctor checks.
cmd_feedback() {
  local session="${1:-}"
  if [ -z "$session" ]; then
    session="$(live_session || true)"
    [ -n "$session" ] || die "feedback: no session given and none is running" \
      "recordfeedback feedback <session directory>"
  fi
  [ -d "$session" ] || die "feedback: no such session directory" "" "check the path: $session"
  [ -f "$session/meta.json" ] || die "feedback: $session has no meta.json" "" \
    "the session never started, there is nothing to write about"

  python3 - "$session" <<'PYTHON'
import json
import os
import sys

session = sys.argv[1]
WORDS_PER_PARAGRAPH = 40
QUOTE_WORDS = 25


def load(name, default):
    path = os.path.join(session, name)
    if not os.path.exists(path):
        return default
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (ValueError, OSError):
        return default


def mtime(name):
    path = os.path.join(session, name)
    return os.stat(path).st_mtime if os.path.exists(path) else None


def mmss(seconds):
    seconds = max(0, int(seconds))
    return "%02d:%02d" % (seconds // 60, seconds % 60)


def duration(seconds):
    seconds = max(0, int(round(seconds)))
    if seconds < 60:
        return "%ds" % seconds
    return "%dm%02ds" % (seconds // 60, seconds % 60)


def home_relative(path):
    home = os.path.expanduser("~")
    if path == home:
        return "~"
    if path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


meta = load("meta.json", {})
# Whisper invents words out of digital silence, "Thank you." above all, so a
# silent session is decided by measuring the audio and never by the transcript.
silent = meta.get("silent") == "true"
transcript = load("transcript.json", {})
shots = load("shots.json", [])
segments = [] if silent else [s for s in transcript.get("transcription", [])
                              if s.get("text", "").strip()]

# The sentences the user spoke at this tool rather than about their work. They
# were acted on while the session ran, and leaving them in the document asks
# Claude Code to act on them a second time as though they were feedback.
commands = load("commands.json", [])
# The parse is guarded above and the shape is guarded here. This document is
# written even when the transcription failed, so it must not be the thing that
# throws over a file somebody edited by hand.
if not isinstance(commands, list):
    commands = []
commands = [one for one in commands if isinstance(one, dict)]


def words_of(text):
    return [word for word, _, _ in tokens_of(text)]


def tokens_of(text):
    """The words of a piece of text, each remembering where it sat in it.

    The offsets are what let one sentence be cut out of a paragraph without
    rewriting the paragraph. Rebuilding it from its bare words costs every
    other sentence in it its capitals and its punctuation, and that paragraph
    is the document a person reads.
    """
    tokens = []
    start = None
    for index, character in enumerate(text):
        if character.isalnum() or character == "'":
            if start is None:
                start = index
        elif start is not None:
            tokens.append((text[start:index].lower(), start, index))
            start = None
    if start is not None:
        tokens.append((text[start:].lower(), start, len(text)))
    return tokens


def scrub(segments, commands):
    """Take each spoken command out of the segment it was transcribed into.

    Two recognisers heard the same seconds of audio and they do not agree word
    for word, so the phrase is found by overlap rather than by equality. Both
    read the same recording, so the offsets are the same clock and the search
    is only ever a few seconds wide.
    """
    removed = []
    for entry in commands:
        wanted = words_of(entry.get("phrase", ""))
        if not wanted:
            continue
        at = float(entry.get("at", 0)) * 1000
        best = None
        for segment in segments:
            begins = segment.get("offsets", {}).get("from", 0)
            ends = segment.get("offsets", {}).get("to", begins)
            # A recogniser reports a command a moment after it was said, and
            # whisper stamps the segment it started in, so the window reaches
            # back further than it reaches forward.
            if ends < at - 6000 or begins > at + 3000:
                continue
            said = words_of(segment["text"])
            if not said:
                continue
            for index in range(len(said)):
                for length in range(1, len(wanted) + 2):
                    window = said[index:index + length]
                    if not window:
                        break
                    hits = sum(1 for w in window if w in wanted)
                    score = hits / max(len(window), len(wanted))
                    if score >= 0.6 and (best is None or score > best[0]):
                        best = (score, segment, index, index + len(window))
        if best is None:
            continue
        _, segment, first, last = best
        # Cut, not rebuilt. Only the characters the matched words occupied are
        # taken out, so everything either side of them keeps the capitals and
        # the punctuation whisper gave it.
        tokens = tokens_of(segment["text"])
        body = segment["text"]
        cut_from = tokens[first][1]
        cut_to = tokens[last - 1][2]
        # The punctuation that trailed the removed sentence goes with it, or the
        # paragraph is left with a stray full stop where the sentence used to be.
        while cut_to < len(body) and body[cut_to] in ".,;:!?":
            cut_to += 1
        kept = (body[:cut_from].rstrip() + " " + body[cut_to:].lstrip()).strip()
        removed.append(entry)
        segment["text"] = " " + kept if kept else ""
    return [s for s in segments if s["text"].strip()], removed


segments, scrubbed = scrub(segments, commands)

start = mtime("start.ref")
stop = mtime("stop.ref")
seconds = (stop - start) if (start and stop and stop > start) else 0
if not seconds and segments:
    seconds = segments[-1].get("offsets", {}).get("to", 0) / 1000.0

# Whisper segments are a few seconds each and one line per segment is
# unreadable, so they merge into paragraphs stamped with the offset of the
# first segment in the paragraph.
shot_offsets = sorted(shot.get("offset_ms", 0) for shot in shots)
paragraphs = []
for segment in segments:
    text = segment["text"].strip()
    offset = segment.get("offsets", {}).get("from", 0)
    start_new = not paragraphs or paragraphs[-1]["words"] >= WORDS_PER_PARAGRAPH
    # A paragraph never spans a screenshot. Without this the merge buries the
    # picture at the end of a paragraph, after sentences that were said later,
    # and the second it was taken is the only thing that places it.
    if paragraphs and not start_new:
        start_new = any(paragraphs[-1]["offset"] <= x < offset for x in shot_offsets)
    if start_new:
        paragraphs.append({"offset": offset, "text": text, "words": len(text.split())})
    else:
        paragraphs[-1]["text"] += " " + text
        paragraphs[-1]["words"] += len(text.split())

# A screenshot belongs after the segment that was being spoken when it was
# taken, which is the last segment starting at or before it. One taken before
# anyone spoke belongs at the top, where -1 puts it.
placed = {}
for shot in shots:
    offset = shot.get("offset_ms", 0)
    index = -1
    for n, paragraph in enumerate(paragraphs):
        if paragraph["offset"] <= offset:
            index = n
        else:
            break
    placed.setdefault(index, []).append(shot)
    spoken = None
    for segment in segments:
        if segment.get("offsets", {}).get("from", 0) <= offset:
            spoken = segment
        else:
            break
    shot["spoken"] = spoken["text"].strip() if spoken else ""


def image(shot):
    return "![Screenshot %s at %s](%s)" % (shot.get("index", "?"), shot.get("elapsed", "00:00"),
                                           shot.get("path", ""))


started = meta.get("started_local") or meta.get("started") or ""
heading = started[:16].replace("T", " ") if started else "unknown time"
language = meta.get("lang") or "auto"
if language == "auto":
    language = transcript.get("result", {}).get("language") or "unknown"

out = []
out.append("# Feedback session %s" % heading)
out.append("")
summary = "Duration %s. %d screenshot%s. Language %s." % (
    duration(seconds), len(shots), "" if len(shots) == 1 else "s", language)
cwd = meta.get("cwd") or ""
if cwd:
    summary += " Started in `%s`" % home_relative(cwd)
    branch = meta.get("branch") or ""
    summary += " on branch `%s`." % branch if branch else "."
out.append(summary)
if meta.get("note"):
    out.append("")
    out.append("Note: %s" % meta["note"])
out.append("")
out.append("## Transcript")
out.append("")

for shot in placed.get(-1, []):
    out.append(image(shot))
    out.append("")

if not segments or silent:
    # No audio and no speech is not a failure, and a reader who knows nothing
    # about the tool has to be told what happened rather than left guessing.
    out.append("The recording was silent. Nothing was said in this session, or the")
    out.append("microphone captured nothing. The screenshots below are what there is.")
    out.append("")
else:
    for n, paragraph in enumerate(paragraphs):
        out.append("[%s] %s" % (mmss(paragraph["offset"] / 1000.0), paragraph["text"]))
        out.append("")
        for shot in placed.get(n, []):
            out.append(image(shot))
            out.append("")

# Kept out of the transcript and reported on their own. They are instructions
# the user gave this tool, which were carried out while the session ran, and a
# reader who takes them for feedback acts on them a second time.
if commands:
    out.append("## Spoken commands")
    out.append("")
    out.append("These were said to the recorder and acted on while the session ran.")
    out.append("They are not feedback and %s taken out of the transcript above."
               % ("were" if scrubbed else "were not found in and so were not"))
    out.append("")
    for entry in commands:
        out.append('%s %s, from "%s"'
                   % (mmss(float(entry.get("at", 0))), entry.get("title", ""),
                      entry.get("phrase", "")))
    out.append("")

out.append("## Screenshots")
out.append("")
if not shots:
    out.append("None were taken.")
else:
    for shot in shots:
        line = "%d. `%s` at %s" % (shot.get("index", 0), shot.get("file", ""),
                                   shot.get("elapsed", "00:00"))
        words = shot.get("spoken", "").split()
        if words:
            quote = " ".join(words[:QUOTE_WORDS])
            if len(words) > QUOTE_WORDS:
                quote += " ..."
            line += ', taken while saying: "%s"' % quote
        else:
            line += ", taken before anything was said"
        out.append(line)
        out.append("   %s" % shot.get("path", ""))
out.append("")

with open(os.path.join(session, "feedback.md"), "w", encoding="utf-8") as handle:
    handle.write("\n".join(out))
PYTHON
}

# Mean volume in dBFS, or nothing when it cannot be measured. Digital silence
# reads as -inf and a muted microphone lands near -91, while a person talking
# in a quiet room is above -40.
audio_dbfs() {
  local wav="$1"
  [ -s "$wav" ] || return 1
  ffmpeg -hide_banner -nostdin -i "$wav" -af volumedetect -f null - 2>&1 \
    | sed -n 's/.*mean_volume: \(-*[0-9.]*\) dB.*/\1/p' | tail -1
}

# ------------------------------------------------------------------------ stop

# Idempotent, because a person who presses the stop hotkey and then runs the
# slash command calls this twice, and because the expensive steps must not be
# repeated or undone the second time.
cmd_stop() {
  local session="${1:-}"
  if [ -z "$session" ]; then
    session="$(live_session || true)"
    if [ -z "$session" ] && [ -L "$CURRENT" ]; then
      session="$(readlink "$CURRENT")"
    fi
    [ -n "$session" ] || die "stop: no session is running and none was given" \
      "recordfeedback stop [session directory]" \
      "start one with: recordfeedback start. The newest finished one: recordfeedback last"
  fi
  [ -d "$session" ] || die "stop: no such session directory" "" "check the path: $session"

  # Only the first stop fixes the end of the window. A second one must not
  # widen it, or it would sweep up screenshots taken after the session.
  [ -f "$session/stop.ref" ] || touch "$session/stop.ref"

  stop_recorder "$session"
  stop_overlay "$session"
  rm -f "$session/ffmpeg.ctl"

  # collect rescans and rewrites shots.json, and by the second stop the shots
  # have already moved into the archive, so rerunning it would empty the file.
  local shots=0
  if [ -f "$session/shots.json" ]; then
    shots="$(jq 'length' "$session/shots.json")"
  else
    shots="$(cmd_collect "$session")"
  fi

  # Transcription is the only step here that needs a model on disk and a
  # working whisper, so it is the step most likely to fail, and it runs in a
  # subshell because its own failure path exits. The audio, the screenshots and
  # their timings all survive it, and throwing the document away rather than
  # writing the half that lived loses everything the user did with their hands.
  local transcribed=1
  if [ -f "$session/transcript.json" ]; then
    transcribed=0
  elif [ ! -s "$session/audio.wav" ]; then
    echo "recordfeedback: this session has no audio, so there is nothing to transcribe." >&2
    echo "  look at $session/ffmpeg.log" >&2
  elif ( cmd_transcribe "$session" ); then
    transcribed=0
  else
    echo "recordfeedback: the words could not be transcribed, so this document is" >&2
    echo "  the screenshots and their timings only. Nothing else was lost." >&2
    echo "  the recording is kept at $session/audio.wav" >&2
    echo "  fix: recordfeedback transcribe $session, then recordfeedback feedback $session" >&2
  fi

  # Whisper hallucinates speech out of silence, so the session is called silent
  # on the evidence of the audio and the transcript is set aside when it is.
  local dbfs silent=false
  dbfs="$(audio_dbfs "$session/audio.wav" || true)"
  if [ -n "$dbfs" ] && [ "$(python3 -c "print(1 if float('$dbfs') <= -60 else 0)" 2>/dev/null || echo 0)" = 1 ]; then
    silent=true
  fi
  set_meta "$session" silent "$silent"

  cmd_feedback "$session"
  set_meta "$session" status done
  # The level segments are scratch that only means anything while the recorder
  # is running. The session keeps the audio, the shots and the document.
  rm -rf "$session/$LEVEL_DIR"
  rm -f "$CURRENT"

  # The same verdict the document is built on. Whisper writes words out of
  # silence, so counting the transcript here put a word count directly above a
  # document saying nothing was said, and the count is the line a person reads
  # first.
  local words=0
  [ "$transcribed" -eq 0 ] && [ "$silent" = false ] && words="$(transcript_words "$session")"
  echo "Session finished."
  echo "  $(format_mmss "$(elapsed_seconds "$session/start.ref" "$session/stop.ref")") recorded, $words words, $shots screenshot$([ "$shots" = 1 ] || echo s)."
  echo "  session: $session"
  # The last line is the path, alone, so the caller can read it without
  # parsing prose.
  echo "$session/feedback.md"
}

# ----------------------------------------------------------------------- usage

usage() {
  cat <<'USAGE'
recordfeedback <command>

  start [--note TEXT] [--device N] [--no-overlay]
                  begin a session: record audio and arm the overlay
  wait [--timeout SECONDS]
                  block until the stop hotkey, the recorder dying, or a timeout
  stop            end the session, collect screenshots, transcribe, write feedback.md
  status          the live session, how long it has run, what it has captured
  abort           stop everything and throw the session away
  last            path of the newest session that has a feedback.md
  devices         the avfoundation audio inputs and their indexes
  doctor          check every dependency, the model, the microphone and the overlay
USAGE
}

# -------------------------------------------------------------------- dispatch

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift || true
  case "$cmd" in
    start) cmd_start "$@" ;;
    status) cmd_status "$@" ;;
    abort) cmd_abort "$@" ;;
    devices) cmd_devices "$@" ;;
    last) cmd_last "$@" ;;
    wait) cmd_wait "$@" ;;
    stop) cmd_stop "$@" ;;
    feedback) cmd_feedback "$@" ;;
    collect) cmd_collect "$@" ;;
    transcribe) cmd_transcribe "$@" ;;
    doctor) cmd_doctor "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command '$cmd'" ;;
  esac
}

main "$@"
